{
  "name": "El modelo propone reenviar a la DIAN la factura que el usuario pide reenviar",
  "priority": 0,
  "request": {
    "method": "POST",
    "urlPath": "/v1/chat/completions",
    "bodyPatterns": [
      { "matches": "(?s).*[Rr]eenv[ií]a.*SET[A-Z][0-9]{6,}.*" },
      { "doesNotMatch": "(?s).*\"role\"\\s*:\\s*\"tool\".*" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "id": "sim-propose",
      "object": "chat.completion",
      "created": 1,
      "model": "simulador",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_2",
                "type": "function",
                "function": {
                  "name": "proposeAction",
                  "arguments": "{\"kind\":\"SEND_TO_DIAN\",\"invoiceNumber\":\"{{regexExtract request.body 'SET[A-Z][0-9]{6,}'}}\",\"reason\":\"El usuario pidió reenviarla\"}"
                }
              }
            ]
          },
          "finish_reason": "tool_calls"
        }
      ],
      "usage": { "prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2 }
    }
  }
}
