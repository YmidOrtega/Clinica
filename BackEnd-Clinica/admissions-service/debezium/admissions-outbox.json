{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "${env:ADMISSIONS_DB_HOST}",
  "database.port": "5432",
  "database.dbname": "${env:ADMISSIONS_DB_NAME}",
  "database.user": "${dir:/run/secrets/kafka-connect:admissions-db-debezium-user}",
  "database.password": "${dir:/run/secrets/kafka-connect:admissions-db-debezium-password}",
  "topic.prefix": "admissions-db",
  "plugin.name": "pgoutput",
  "slot.name": "admissions_outbox",
  "publication.name": "admissions_outbox_pub",
  "publication.autocreate.mode": "disabled",
  "schema.include.list": "admissions_outbox",
  "table.include.list": "admissions_outbox.outbox_events",
  "tombstones.on.delete": "false",
  "snapshot.mode": "initial",
  "topic.creation.default.partitions": "3",
  "topic.creation.default.replication.factor": "${env:KAFKA_REPLICATION_FACTOR}",
  "topic.creation.default.cleanup.policy": "compact",
  "topic.creation.default.min.compaction.lag.ms": "3600000",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id": "id",
  "transforms.outbox.table.field.event.key": "aggregateid",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.fields.additional.placement": "type:header:eventType",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.route.by.field": "aggregatetype",
  "transforms.outbox.route.topic.replacement": "${routedByValue}.v1"
}
