{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::clinical-attachments-staging/attachments/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::clinical-attachments-staging"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion", "s3:PutObjectRetention", "s3:GetObjectRetention"],
      "Resource": ["arn:aws:s3:::clinical-attachments/attachments/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketObjectLockConfiguration"],
      "Resource": ["arn:aws:s3:::clinical-attachments"]
    }
  ]
}
