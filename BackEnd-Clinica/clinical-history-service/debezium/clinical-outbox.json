{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "${env:CLINICAL_DB_HOST}",
  "database.port": "3306",
  "database.user": "${dir:/run/secrets/kafka-connect:clinical-db-debezium-user}",
  "database.password": "${dir:/run/secrets/kafka-connect:clinical-db-debezium-password}",
  "database.server.id": "5402",
  "topic.prefix": "clinical-db",
  "database.include.list": "clinical_outbox",
  "table.include.list": "clinical_outbox.outbox_events",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",
  "snapshot.mode": "initial",
  "snapshot.locking.mode": "none",
  "schema.history.internal.kafka.bootstrap.servers": "${env:BOOTSTRAP_SERVERS}",
  "schema.history.internal.kafka.topic": "clinical-db.schema-history",
  "schema.history.internal.store.only.captured.databases.ddl": "true",
  "schema.history.internal.store.only.captured.tables.ddl": "true",
  "topic.creation.default.partitions": "3",
  "topic.creation.default.replication.factor": "${env:KAFKA_REPLICATION_FACTOR}",
  "topic.creation.default.cleanup.policy": "delete",
  "topic.creation.default.retention.ms": "-1",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id": "id",
  "transforms.outbox.table.field.event.key": "aggregateid",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.fields.additional.placement": "type:header:eventType",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.route.by.field": "aggregatetype",
  "transforms.outbox.route.topic.replacement": "${routedByValue}.v1"
}
